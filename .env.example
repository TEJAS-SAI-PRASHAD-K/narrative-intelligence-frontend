# Base URL of the Phase 4 FastAPI backend. No trailing slash, no /api/v1 suffix.
VITE_API_BASE_URL=http://localhost:8000

# LOCAL-ONLY, CAPSTONE-SCOPED. See README "API key handling".
# Copy this file to .env.local and paste a real key. .env.local is gitignored.
# NEVER commit a real key in any VITE_-prefixed variable.
VITE_API_KEY=replace-me-in-env-local
