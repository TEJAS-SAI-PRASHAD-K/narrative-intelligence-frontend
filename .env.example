# Copy to .env.local (gitignored) and edit. See README "Choosing a backend".

# --- Option A: DEMO_MODE fixtures -------------------------------------------
# No database, no key, read-only. Writes are accepted and discarded.
#   cd ../narrative-intelligence && DEMO_MODE=1 .venv/bin/uvicorn app.main:app --port 8001
VITE_API_BASE_URL=http://localhost:8001
VITE_API_KEY=demo-mode-needs-no-key

# --- Option B: the real backend ---------------------------------------------
# Real corpus, real jobs. Needs a key with at least the `read` scope; `write`
# for reclustering and reports, `admin` for /settings/keys.
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_KEY=<paste a real key here — NEVER commit it>
